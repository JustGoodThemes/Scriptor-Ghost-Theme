<footer class="footer container">
    {{#if @site.secondary_navigation}}
        <div class="footer-nav">
            {{navigation type="secondary"}}
        </div>
    {{/if}}
    <div class="footer-social">
        {{#if @site.facebook}}
            <a href="{{social_url type="facebook"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="Facebook">
                {{> "icons/facebook"}}
            </a>
        {{/if}}
        {{#if @site.twitter}}
            <a href="{{social_url type="twitter"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="X">
                {{> "icons/x"}}
            </a>
        {{/if}}
        {{#if @site.linkedin}}
            <a href="{{social_url type="linkedin"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="LinkedIn">
                {{> "icons/linkedin"}}
            </a>
        {{/if}}
        {{#if @site.bluesky}}
            <a href="{{social_url type="bluesky"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="Bluesky">
                {{> "icons/bluesky"}}
            </a>
        {{/if}}
        {{#if @site.threads}}
            <a href="{{social_url type="threads"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="Threads">
                {{> "icons/threads"}}
            </a>
        {{/if}}
        {{#if @site.mastodon}}
            <a href="{{social_url type="mastodon"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="Mastodon">
                {{> "icons/mastodon"}}
            </a>
        {{/if}}
        {{#if @site.tiktok}}
            <a href="{{social_url type="tiktok"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="TikTok">
                {{> "icons/tiktok"}}
            </a>
        {{/if}}
        {{#if @site.youtube}}
            <a href="{{social_url type="youtube"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="YouTube">
                {{> "icons/youtube"}}
            </a>
        {{/if}}
        {{#if @site.instagram}}
            <a href="{{social_url type="instagram"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="Instagram">
                {{> "icons/instagram"}}
            </a>
        {{/if}}
    </div>
    <div class="footer-info">
        <p class="footer-copyright">
            {{#if @custom.copyright_text}}
                {{@custom.copyright_text}}
            {{else}}
                <a href="{{@site.url}}">{{@site.title}}</a> &copy; {{date format="YYYY"}}. <br /> {{{t "Published with {ghostlink}. Scriptor theme by {jgtlink}." ghostlink="<a target=\"_blank\" href=\"https://ghost.org\" rel=\"noopener\">Ghost</a>" jgtlink="<a target=\"_blank\" href=\"https://justgoodthemes.com/\" rel=\"noopener\">Just Good Themes</a>" }}}
            {{/if}}
        </p>
        <a href="#page" class="footer-top-btn btn btn-icon" aria-label="{{t "Back to the top"}}">
            {{> "icons/arrow-up"}}
        </a>
    </div>
</footer>

<nav class="navbar container">
    <div class="navbar-content">
        {{#if @site.logo}}
            <a class="navbar-logo" href="{{@site.url}}"><img src="{{@site.logo}}" alt="{{@site.title}}" /></a>
        {{/if}}
        {{#is "index"}}
            <h1 class="navbar-title{{#if @site.logo}} sr-only{{/if}}"><a href="{{@site.url}}">{{@site.title}}</a></h1>
        {{else}}
            <p class="navbar-title{{#if @site.logo}} sr-only{{/if}}"><a href="{{@site.url}}">{{@site.title}}</a></p>
        {{/is}}
        {{#if @site.navigation}}
            <button type="button" id="navbar-menu-btn" class="navbar-menu-btn btn btn-icon btn-link" aria-controls="navbar-menu" aria-expanded="false" aria-label="{{t 'Menu'}}">
                <span class="icon-menu">{{> "icons/menu"}}</span>
                <span class="icon-close">{{> "icons/close"}}</span>
            </button>
            <div id="navbar-menu" class="navbar-menu">
                {{navigation}}
            </div>
        {{/if}}
        <button type="button" class="navbar-search-btn btn btn-icon btn-link" aria-label="{{t 'Search'}}" data-ghost-search>{{> "icons/search"}}</button>
    </div>
</nav>

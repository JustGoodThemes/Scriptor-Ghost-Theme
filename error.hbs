{{!< default}}
{{!-- Generic error page --}}

<section class="error container">
    <h1 class="error-title">{{statusCode}}</h1>
    <p class="error-description">{{message}}</p>
    <p>
        <a class="error-link" href="{{@site.url}}">{{> "icons/arrow-left"}} {{t "Back to home"}}</a>
    </p>
</section>
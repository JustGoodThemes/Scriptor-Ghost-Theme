{{!< default}}
{{!-- Single post --}}

{{#post}}
    <article class="{{post_class}}">
        <header class="post-header container">
            <div class="post-meta">
                {{#if featured}}
                <span class="post-featured-badge">{{t "Featured"}}</span>
                {{/if}}
                <time datetime="{{date format='YYYY-MM-DD'}}">{{date format="DD MMMM YYYY"}}</time>
            </div>
            <h1 class="post-title">{{title}}</h1>
            <div class="post-byline">
                {{authors separator=", " prefix=(t "Posted by ")}}
                {{tags separator=", " prefix=(t " in ")}}
            </div>
            {{#if feature_image}}
                <figure class="post-image">
                    <img
                        srcset="{{img_url feature_image size="s" format="webp"}} 400w,
                                {{img_url feature_image size="m" format="webp"}} 600w,
                                {{img_url feature_image size="l" format="webp"}} 800w,
                                {{img_url feature_image size="xl" format="webp"}} 1200w"
                        sizes="(min-width: 820px) 760px, 92vw"
                        src="{{img_url feature_image size="l" format="webp"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{/if}}"
                    />
                   {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>
            {{/if}}
        </header>

        <div class="post-content">
            {{content}}
        </div>

        <div class="post-share container">
            <a href="#/share" class="btn">{{> "icons/share"}}{{t "Share this post"}}</a>
        </div>

        <div class="author-box container">
            {{#foreach authors}}
                <div class="author-profile">
                    {{#if profile_image}}
                      <div class="author-image">
                          <img src="{{img_url profile_image size="xs" format="webp"}}" alt="{{name}}" />
                      </div>
                    {{/if}}
                    <div class="author-details">
                        <h2 class="author-title">{{t "About"}} <a href="{{url}}">{{name}}</a></h2>
                        {{#if bio}}
                            <p class="author-bio">{{bio}}</p>
                        {{/if}}
                        <div class="author-links">
                            {{#if location}}
                                <span>{{location}}</span>
                            {{/if}}
                            {{#if website}}
                                <a href="{{website}}" target="_blank" rel="noopener">{{website}}</a>
                            {{/if}}
                            {{#if twitter}}
                                <a href="{{social_url type="twitter"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="X">{{> "icons/x"}}</a>
                            {{/if}}
                            {{#if facebook}}
                                <a href="{{social_url type="facebook"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="Facebook">{{> "icons/facebook"}}</a>
                            {{/if}}
                            {{#if linkedin}}
                                <a href="{{social_url type="linkedin"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="LinkedIn">{{> "icons/linkedin"}}</a>
                            {{/if}}
                            {{#if bluesky}}
                                <a href="{{social_url type="bluesky"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="BlueSky">{{> "icons/bluesky"}}</a>
                            {{/if}}
                            {{#if threads}}
                                <a href="{{social_url type="threads"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="Threads">{{> "icons/threads"}}</a>
                            {{/if}}
                            {{#if mastodon}}
                                <a href="{{social_url type="mastodon"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="Mastodon">{{> "icons/mastodon"}}</a>
                            {{/if}}
                            {{#if tiktok}}
                                <a href="{{social_url type="tiktok"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="TikTok">{{> "icons/tiktok"}}</a>
                            {{/if}}
                            {{#if youtube}}
                                <a href="{{social_url type="youtube"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="YouTube">{{> "icons/youtube"}}</a>
                            {{/if}}
                            {{#if instagram}}
                                <a href="{{social_url type="instagram"}}" class="btn btn-icon btn-link" target="_blank" rel="noopener" aria-label="Instagram">{{> "icons/instagram"}}</a>
                            {{/if}}
                        </div>
                    </div>
                </div>
            {{/foreach}}
        </div>
    </article>

    {{#if comments}}
        {{> comments}}
    {{/if}}
{{/post}}

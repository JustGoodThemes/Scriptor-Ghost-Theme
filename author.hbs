{{!< default}}
{{!-- Author archive page --}}

<div class="container">
    {{#author}}
        <header class="page-header">
            <h1 class="page-title">{{plural ../pagination.total empty=(t "No posts by") singular=(t "% post by") plural=(t "% posts by")}} <span class="page-title-highlight">{{name}}</span></h1>
        </header>
    {{/author}}

    {{> "loop"}}
</div>
